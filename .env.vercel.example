# Vercel Environment Variables — Noor Safar
# Copy into Vercel → Project → Settings → Environment Variables
# Apply to: Production, Preview, Development

# ── REQUIRED ──────────────────────────────────────────────────────────

# Leave empty — frontend uses same-domain /api rewrites
NEXT_PUBLIC_API_URL=

# Supabase Postgres connection string (Settings → Database → Connection string → URI)
# Example: postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
POSTGRES_URL=

# Your live site URL (add all domains you use)
CORS_ORIGINS=https://noor-travels-chi.vercel.app,https://noor-travels.vercel.app,http://localhost:3000

# Must be 0 on Vercel (no local SQLite file in serverless)
FORCE_SQLITE=0

# Use OpenAI for embeddings in production (no local ML models)
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BATCH_SIZE=16

# ── CHAT (pick one) ─────────────────────────────────────────────────
# Option A — free local retrieval (works after DB is seeded):
CHAT_PROVIDER=local

# Option B — better answers with OpenAI (recommended):
# CHAT_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# CHAT_MODEL=gpt-4o-mini

OPENAI_API_KEY=

# ── KHUTBA LIVE TRANSCRIPTION (optional) ────────────────────────────
DEEPGRAM_API_KEY=

# ── RAG TUNING ──────────────────────────────────────────────────────
RAG_MIN_SIMILARITY=0.42
RAG_RETRIEVAL_K=20
RAG_FINAL_K=5
RAG_CACHE_TTL_HOURS=168
CHAT_MODEL=gpt-4o-mini

# ── SUPABASE (optional, if using Supabase client features) ──────────
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
