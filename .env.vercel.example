# Import this shape into Vercel. Do not commit real values.
#
# Important:
# - Leave NEXT_PUBLIC_API_URL empty in Vercel so the frontend uses same-domain /api rewrites.
# - Use Postgres/Supabase in production. Do not set FORCE_SQLITE=1 on Vercel.

NEXT_PUBLIC_API_URL=

OPENAI_API_KEY=
DEEPGRAM_API_KEY=

POSTGRES_URL=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

FORCE_SQLITE=0
CORS_ORIGINS=https://noor-travels.vercel.app,http://localhost:3000

CHAT_PROVIDER=local
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BATCH_SIZE=16
RAG_MIN_SIMILARITY=0.42
RAG_RETRIEVAL_K=20
RAG_FINAL_K=5
RAG_CACHE_TTL_HOURS=168
CHAT_MODEL=gpt-4o-mini
