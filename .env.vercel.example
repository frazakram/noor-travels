# Vercel Environment Variables — Noor Safar
# Vercel → Project → Settings → Environment Variables (Production + Preview), then Redeploy.
# See VERCEL_DEPLOY.md for what each one does. Never commit real values.

# ── REQUIRED ──────────────────────────────────────────────────────────
# Supabase pooler URI (Settings → Database → Connection string → URI, port 6543)
POSTGRES_URL=
CORS_ORIGINS=https://noor-travels-chi.vercel.app

CHAT_PROVIDER=groq
GROQ_API_KEY=
DEEPGRAM_API_KEY=

# Query embeddings come from the frontend's /api/embed (MiniLM, 384 dims — matches the DB column)
EMBEDDING_PROVIDER=xenova

# Long random strings (e.g. `openssl rand -hex 32`)
AUTH_SECRET=
EMBED_SECRET=

# Leave empty — the frontend calls same-origin /api
NEXT_PUBLIC_API_URL=

# ── OPTIONAL ──────────────────────────────────────────────────────────
# GROQ_CHAT_MODEL=openai/gpt-oss-20b
# GROQ_FALLBACK_MODELS=qwen/qwen3.8-27b,openai/gpt-oss-120b
# OPENAI_API_KEY=            # only with CHAT_PROVIDER=openai
# NEXT_PUBLIC_SITE_URL=https://noor-travels-chi.vercel.app
# RAG_CACHE_TTL_HOURS=168
