{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "frontend/",
      "framework": "nextjs"
    },
    "backend": {
      "root": "backend/",
      "entrypoint": "app.main:app",
      "functions": {
        "app/**/*.py": {
          "excludeFiles": "{../frontend/**,../node_modules/**,../data/**,../scripts/**,ingestion/**,data/**,migrations/**,**/.venv/**,**/venv/**,**/__pycache__/**,**/*.pyc,**/*.db,**/*.sqlite*,**/.huggingface/**,**/.cache/**}"
        }
      }
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
