#!/bin/sh
# Regenerates docs/CONTEXT_GRAPH.md so every commit carries an up-to-date
# context graph. Never blocks the commit — a generation failure only warns.
#
# Install (one-time, .git/hooks is not versioned):
#   cp scripts/hooks/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit

if python3 scripts/context_graph.py >/dev/null 2>&1; then
    git add docs/CONTEXT_GRAPH.md
else
    echo "context-graph: generation failed, committing without refresh" >&2
fi
exit 0
